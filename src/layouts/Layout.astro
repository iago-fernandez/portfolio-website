---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://iagofernandez.dev');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(image, siteUrl);
const lang = getLangFromUrl(Astro.url);

const enPath = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const esPath = enPath === '/' ? '/es' : `/es${enPath}`;
const enURL = new URL(enPath, siteUrl);
const esURL = new URL(esPath, siteUrl);
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
---

<!doctype html>
<html lang={lang} class="bg-zinc-50 dark:bg-zinc-900">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="en" href={enURL} />
        <link rel="alternate" hreflang="es" href={esURL} />
        <link rel="alternate" hreflang="x-default" href={enURL} />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <ClientRouter />

        <script is:inline>
            const setTheme = () => {
                const preference = typeof localStorage !== 'undefined' && localStorage.getItem('theme') 
                    ? localStorage.getItem('theme') 
                    : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.classList[preference === 'dark' ? 'add' : 'remove']('dark');
            };
            setTheme();
            
            document.addEventListener('astro:after-swap', setTheme);

            document.addEventListener('astro:before-swap', (e) => {
                const isDark = document.documentElement.classList.contains('dark');
                if (isDark) {
                    e.newDocument.documentElement.classList.add('dark');
                } else {
                    e.newDocument.documentElement.classList.remove('dark');
                }
            });
        </script>
    </head>
    <body class="bg-zinc-50 text-zinc-900 antialiased selection:bg-blue-600 selection:text-white dark:bg-zinc-900 dark:text-zinc-300 pt-16 flex flex-col min-h-screen relative overflow-y-scroll overflow-x-hidden">
        
        <div class="pointer-events-none fixed inset-0 z-0 bg-grid-pattern"></div>        
        
        <div class="relative z-10 flex flex-col flex-grow w-full">
            <Header />
            <div class="flex-grow flex flex-col">
                <main class="flex-grow flex flex-col w-full">
                    <slot />
                </main>
            </div>
            <Footer />
        </div>
        
    </body>
</html>