---
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.webp';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const githubUrl = "https://github.com/iago-fernandez";
const linkedinUrl = "https://linkedin.com/in/iago-fernandez-perlo/";
const cvUrl = lang === 'es' ? '/[ES]CV_Iago_Fernandez.pdf' : '/[EN]CV_Iago_Fernandez.pdf';
---

<section id="hero-container" class="relative w-full overflow-hidden pt-8 pb-20 bg-zinc-50 dark:bg-zinc-900">
<canvas id="network-canvas" aria-hidden="true" class="absolute inset-0 z-0 h-full w-full opacity-80 pointer-events-none dark:opacity-70 transition-opacity duration-300"></canvas>
    <div class="mx-auto max-w-7xl px-6 sm:px-12 relative z-10">
        <div class="grid min-h-[85vh] grid-cols-1 items-center gap-y-12 gap-x-8 lg:grid-cols-12">
            <div class="order-2 min-w-0 animate-fade-in-up lg:order-1 lg:col-span-7 xl:col-span-8 lg:pr-8">
                <h1 class="text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-5xl lg:text-6xl xl:text-7xl transition-colors duration-300">
                    Iago Fernandez
                </h1>
                <h2 class="mt-4 text-xl font-semibold text-zinc-700 dark:text-zinc-300 sm:text-2xl xl:text-3xl transition-colors duration-300">
                    {t('hero.subtitle')}
                </h2>
                <div class="mt-6 max-w-3xl animation-delay-200">
                    <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-lg transition-colors duration-300 text-pretty">
                        {t('hero.description')}
                    </p>
                </div>
                <div class="mt-10 flex flex-col sm:flex-row gap-4 animation-delay-400 w-full sm:w-auto">
                    <a href={cvUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto items-center justify-center rounded-md bg-zinc-900 px-6 py-3 text-sm font-medium text-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200 hover:shadow-lg active:translate-y-0">
                        {t('hero.cv')}
                    </a>
                    <div class="flex flex-row gap-4 w-full sm:w-auto">
                        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex flex-1 sm:flex-none items-center justify-center rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-6 py-3 text-sm font-medium text-zinc-900 dark:text-zinc-200 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-zinc-300 dark:hover:border-zinc-600 hover:bg-zinc-50 dark:hover:bg-zinc-700 hover:shadow-lg active:translate-y-0">
                            GitHub
                        </a>
                        <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="inline-flex flex-1 sm:flex-none items-center justify-center rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-6 py-3 text-sm font-medium text-zinc-900 dark:text-zinc-200 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-zinc-300 dark:hover:border-zinc-600 hover:bg-zinc-50 dark:hover:bg-zinc-700 hover:shadow-lg active:translate-y-0">
                            LinkedIn
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="order-1 flex justify-center animate-fade-in-up animation-delay-200 lg:order-2 lg:col-span-5 xl:col-span-4 lg:justify-end pointer-events-none">
                <div class="pointer-events-auto relative flex h-56 w-56 flex-shrink-0 items-center justify-center overflow-hidden rounded-full border-4 border-white dark:border-zinc-700 bg-white dark:bg-zinc-700 shadow-md transition-all duration-500 ease-out hover:scale-[1.02] hover:shadow-2xl hover:shadow-blue-900/20 dark:hover:shadow-blue-500/10 sm:h-72 sm:w-72 lg:h-80 lg:w-80">
                    <Image src={profileImage} alt="Iago Fernandez" class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-105" loading="eager" width={320} height={320}/>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', () => {
        const canvas = document.getElementById('network-canvas') as HTMLCanvasElement | null;
        const container = document.getElementById('hero-container');
        if (!canvas || !container) return;

        if (canvas.dataset.initialized === 'true') return;
        canvas.dataset.initialized = 'true';

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const controller = new AbortController();
        const { signal } = controller;

        let width = container.offsetWidth;
        let height = container.offsetHeight;
        let dpr = Math.min(window.devicePixelRatio || 1, 2);

        const resizeCanvas = () => {
            width = container.offsetWidth;
            height = container.offsetHeight;
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = Math.floor(width * dpr);
            canvas.height = Math.floor(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resizeCanvas();

        let connectionRadius = 150;
        let connectionRadiusSq = connectionRadius * connectionRadius;
        let mouseInteractionRadius = 220;
        let mouseInteractionRadiusSq = mouseInteractionRadius * mouseInteractionRadius;
        let connDivisor = 500;

        const mouse = { x: -9999, y: -9999 };
        let needsResize = false;
        let animationId: number | null = null;

        class Particle {
            x: number;
            y: number;
            vx: number;
            vy: number;
            size: number;

            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.vx = (Math.random() - 0.5) * 0.6;
                this.vy = (Math.random() - 0.5) * 0.6;
                this.size = Math.random() * 2.5 + 1;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                const dxMouse = mouse.x - this.x;
                const dyMouse = mouse.y - this.y;
                const distSq = dxMouse * dxMouse + dyMouse * dyMouse;

                if (distSq > 0 && distSq < mouseInteractionRadiusSq) {
                    const distMouse = Math.sqrt(distSq);
                    const force = (mouseInteractionRadius - distMouse) / mouseInteractionRadius;
                    this.x -= (dxMouse / distMouse) * force * 3.5;
                    this.y -= (dyMouse / distMouse) * force * 3.5;
                }

                if (this.x < 0) {
                    this.x = 0;
                    this.vx *= -1;
                } else if (this.x > width) {
                    this.x = width;
                    this.vx *= -1;
                }

                if (this.y < 0) {
                    this.y = 0;
                    this.vy *= -1;
                } else if (this.y > height) {
                    this.y = height;
                    this.vy *= -1;
                }
            }
        }

        let particles: Particle[] = [];

        const updateCanvasConfiguration = () => {
            const currentWidth = window.innerWidth;
            const currentHeight = container.offsetHeight;
            const area = currentWidth * currentHeight;

            const targetCount = Math.max(50, Math.floor(area * 0.00010));
            const scale = Math.max(0.6, Math.min(1, currentWidth / 1200));

            connectionRadius = 150 * scale;
            connectionRadiusSq = connectionRadius * connectionRadius;
            mouseInteractionRadius = 220 * scale;
            mouseInteractionRadiusSq = mouseInteractionRadius * mouseInteractionRadius;
            connDivisor = 500 * scale;

            if (particles.length > targetCount) {
                particles.splice(targetCount);
            }
            while (particles.length < targetCount) {
                particles.push(new Particle());
            }
        };

        updateCanvasConfiguration();

        const renderFrame = (shouldUpdate: boolean) => {
            ctx.clearRect(0, 0, width, height);
            const isDark = document.documentElement.classList.contains('dark');
            ctx.fillStyle = isDark ? 'rgba(96, 165, 250, 0.45)' : 'rgba(37, 99, 235, 0.45)';
            ctx.lineWidth = isDark ? 1.0 : 1.5;

            for (let i = 0; i < particles.length; i++) {
                const p = particles[i];
                if (shouldUpdate) {
                    p.update();
                }

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();

                for (let j = i + 1; j < particles.length; j++) {
                    const q = particles[j];
                    const dx = p.x - q.x;
                    const dy = p.y - q.y;
                    const distSq = dx * dx + dy * dy;

                    if (distSq < connectionRadiusSq) {
                        const distance = Math.sqrt(distSq);
                        const alpha = Math.max(0, 0.35 - (distance / connDivisor));
                        ctx.strokeStyle = isDark
                            ? `rgba(96, 165, 250, ${alpha * 0.8})`
                            : `rgba(37, 99, 235, ${alpha})`;
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(q.x, q.y);
                        ctx.stroke();
                    }
                }
            }
        };

        const applyResize = () => {
            resizeCanvas();
            updateCanvasConfiguration();

            particles.forEach((p) => {
                if (p.x > width) p.x = Math.random() * width;
                if (p.y > height) p.y = Math.random() * height;
            });

            needsResize = false;
        };

        const resizeObserver = new ResizeObserver(() => {
            if (prefersReducedMotion) {
                applyResize();
                renderFrame(false);
            } else {
                needsResize = true;
            }
        });
        resizeObserver.observe(container);

        const resetMousePosition = () => {
            mouse.x = -9999;
            mouse.y = -9999;
        };

        const setPointerFromClient = (target: EventTarget | null, clientX: number, clientY: number) => {
            const element = target instanceof HTMLElement ? target : null;
            if (element && element.closest('a, button, img, .pointer-events-auto') !== null) {
                resetMousePosition();
                return;
            }

            const rect = container.getBoundingClientRect();
            mouse.x = clientX - rect.left;
            mouse.y = clientY - rect.top;
        };

        const stopAnimation = () => {
            if (animationId !== null) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }
        };

        const animate = () => {
            if (document.hidden) {
                animationId = null;
                return;
            }

            if (needsResize) {
                applyResize();
            }

            renderFrame(true);
            animationId = requestAnimationFrame(animate);
        };

        if (prefersReducedMotion) {
            renderFrame(false);
        } else {
            container.addEventListener('mousemove', (e: MouseEvent) => {
                setPointerFromClient(e.target, e.clientX, e.clientY);
            }, { signal });
            container.addEventListener('mouseleave', resetMousePosition, { signal });

            const handleTouch = (e: TouchEvent) => {
                if (e.touches.length === 0) return;
                setPointerFromClient(e.target, e.touches[0].clientX, e.touches[0].clientY);
            };
            container.addEventListener('touchstart', handleTouch, { passive: true, signal });
            container.addEventListener('touchmove', handleTouch, { passive: true, signal });
            container.addEventListener('touchend', resetMousePosition, { signal });

            // Pause the animation loop while the tab is hidden to avoid background CPU usage.
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    stopAnimation();
                } else if (animationId === null) {
                    animationId = requestAnimationFrame(animate);
                }
            }, { signal });

            animate();
        }

        document.addEventListener('astro:before-swap', () => {
            stopAnimation();
            resizeObserver.disconnect();
            controller.abort();
            particles = [];
        }, { once: true });
    });
</script>